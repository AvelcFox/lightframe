      "dev.puffspark.lightframe.LightFrame"
    ],
    "client": [
      "dev.puffspark.lightframe.LightFrameClient"
    ]
  },
  "mixins": [
    "lightframe.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.15.0",
